# Supabase — from your project's API settings (or `supabase start` for local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (server-side only — never expose to the client). Optional; a graceful
# fallback tutor is used when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Whiteboard scanning (OCR). Both are optional and both have free tiers — with
# neither set, scanning uses OCR.space's public demo key.
#   Google AI Studio (best at handwriting/maths): https://aistudio.google.com/apikey
#   OCR.space free key (25k scans/month):         https://ocr.space/ocrapi/freekey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OCR_SPACE_API_KEY=

# Stripe (optional). Checkout is disabled gracefully when unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_MONTHLY=

# Pusher (World Ladder realtime)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
