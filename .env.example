# Supabase — from your project's API settings (or `supabase start` for local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (server-side only — never expose to the client). Optional; a graceful
# fallback tutor is used when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (optional). Checkout is disabled gracefully when unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
